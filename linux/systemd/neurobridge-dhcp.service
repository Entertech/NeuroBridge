[Unit]
Description=NeuroBridge optional DHCP service for the dedicated B-side Ethernet link
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Exit code 1 from ExecCondition means static mode: skip this optional unit.
ExecCondition=/opt/neurobridge/venv/bin/neurobridge-dhcp-config --config /etc/neurobridge/gateway.toml --check-enabled
RuntimeDirectory=neurobridge
RuntimeDirectoryMode=0750
ExecStartPre=/opt/neurobridge/venv/bin/neurobridge-dhcp-config --config /etc/neurobridge/gateway.toml --output /run/neurobridge/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/run/neurobridge/dnsmasq.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/neurobridge
ReadWritePaths=/run/neurobridge /var/log/neurobridge

[Install]
WantedBy=multi-user.target
