[Unit]
Description=NeuroBridge dedicated Ethernet address maintenance
After=network.target
PartOf=neurobridge.service

[Service]
Type=simple
ExecStart=/opt/neurobridge/venv/bin/python -m neurobridge.wired_address --config /etc/neurobridge/gateway.toml --watch
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=neurobridge-wired-address
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/neurobridge-wired-address
