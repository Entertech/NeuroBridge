[Unit]
Description=NeuroBridge Flowtime gateway
After=network.target bluetooth.target
Wants=network.target bluetooth.target neurobridge-wired-address.service

[Service]
Type=simple
User=neurobridge
Group=neurobridge
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/opt/neurobridge/venv/bin/python -m neurobridge.wired_address --config /etc/neurobridge/gateway.toml
ExecStart=/opt/neurobridge/venv/bin/neurobridge --config /etc/neurobridge/gateway.toml
Restart=always
RestartSec=3
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/neurobridge /var/log/neurobridge

[Install]
WantedBy=multi-user.target
