{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Entertech/NeuroBridge/schemas/release-target-verification.schema.json",
  "title": "NeuroBridge native package verification input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetId",
    "targetArchitecture",
    "sourceCommit",
    "fileName",
    "sha256",
    "automatedValidation",
    "validationLog",
    "toolchain",
    "runtimeSha256",
    "inputSha256",
    "sourceReferences",
    "builtAt"
  ],
  "properties": {
    "targetId": { "type": "string", "pattern": "^(windows-(7|10|11)-(x86|x86_64)-(exe|msi)|kylin-(server|desktop)-(x86_64|arm64|loongarch64|mips64el|sw64)-(deb|rpm))$" },
    "targetArchitecture": { "enum": ["x86", "x86_64", "arm64", "loongarch64", "mips64el", "sw64"] },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "fileName": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "automatedValidation": { "const": "passed" },
    "validationLog": { "type": "string", "minLength": 1 },
    "toolchain": { "type": "string", "minLength": 1 },
    "runtimeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "inputSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "builtAt": { "type": "string", "format": "date-time" },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "retrievedAt", "sha256"],
        "properties": {
          "kind": { "enum": ["os-matrix", "dependency", "install-source", "other"] },
          "url": { "type": "string", "format": "uri" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  }
}
