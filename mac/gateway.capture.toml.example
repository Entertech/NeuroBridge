# macOS 头环原始数据采集 POC 配置。
# 复制为 mac/gateway.capture.toml 后再运行；该文件已被 .gitignore 忽略。
# 录制数据必须保留在项目目录外，且不得提交或共享未获授权的人体数据。

[server]
# 仅允许本机 B 端联调页访问。不要将 POC 服务暴露到公共网络。
host = "127.0.0.1"
port = 8765
path = "/neurobridge/v1/ws"

[ble]
# 此 POC 会扫描、连接匹配头环、订阅通知，并向 FF21 写入 0x05 开始采集。
enabled = true
device_name = "Flowtime Headband"
model_nbr_uuid = "0000ff10-1212-abcd-1523-785feabcd123"
scan_timeout_seconds = 5
reconnect_delay_seconds = 3

[recording]
# 使用项目外目录，避免原始人体数据误入 Git 工作区。
directory = "/tmp/neurobridge-headband-poc"
subject_id = "POC-LOCAL"
# 首次采集时保持为空；采集结束后按 README 中的步骤填写实际 recording ID 才能录播。
replay_recording_id = ""
replay_speed = 1.0

[algorithm]
# 当前只完成合成数据构建，尚未用已确认的 FF31/FF51 原始字节验证 SDK
# 输入分组。保持关闭，完成真实录制数据 POC 后才可启用。
enabled = false
command = ["/tmp/neurobridge-affective-runtime/affective_bridge"]
