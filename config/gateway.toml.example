# Copy to /etc/neurobridge/gateway.toml; do not put recordings in git.
config_schema_version = 1
profile = "kylin_headset_local"

[server]
host = "127.0.0.1"
port = 8765
path = "/neurobridge/v1/ws"

[access]
# local_browser: the default single-machine strategy. The bundled browser UI,
# WebSocket service, and downloads bind only to 127.0.0.1; no B-side cable,
# static Ethernet address, or DHCP service is required.
# wired_b_side: legacy strategy for a separate B-side host on an isolated
# Ethernet link. Set server/download to the approved private address, disable
# local_ui, and configure the [network] fields documented below.
mode = "local_browser"

[local_ui]
enabled = true
host = "127.0.0.1"
port = 8080
# The deployed checkout contains the browser assets at this path. Source-tree
# runs may omit it and use the auto-detected web/b-client-test directory.
directory = "/opt/neurobridge/web/b-client-test"

[network]
# local_browser keeps this static with no interface or subnet fields; traffic
# stays on the operating-system loopback device.
mode = "static"
# Legacy wired_b_side static example:
# interface = "enp1s0"
# subnet_cidr = "192.168.88.0/24"
# Legacy wired_b_side DHCP additionally requires:
# dhcp_range_start = "192.168.88.20"
# dhcp_range_end = "192.168.88.200"
# dhcp_lease_time = "12h"

# USB is the physical cable, but Linux transport selection depends on how the
# device enumerates: /dev/ttyACM* or /dev/ttyUSB* means serial; HID, Bulk, or
# Interrupt endpoints mean native usb. The confirmed Kylin deployment is
# serial. Native usb remains blocked until its VID/PID/interface/endpoints and
# transfer contract are confirmed. Use bluetooth only for an approved BLE
# regression deployment. Changing this value requires a service restart.
# The Kylin product installer grants the service account only the group of an
# actually enumerated ttyACM/ttyUSB node and stops when none is present.
[data_source]
type = "serial"
window_interval_ms = 600
stale_after_ms = 1800

[serial]
# auto probes only USB-derived ttyACM/ttyUSB candidates in stable order and
# stops after the first candidate returns standalone 0x01 to the active ACK.
device = "auto"
candidate_types = ["ttyACM", "ttyUSB"]
baud_rate = 115200
# Observe each newly opened candidate for an already-running valid 28-byte EEG
# stream before sending the active handshake ACK.
handshake_timeout_ms = 1000
# Wait this long for a standalone 0x01 after the 7-byte handshake ACK. Complete
# periodic handshakes inside this window are re-ACKed and do not end the wait.
command_response_timeout_ms = 1000
data_timeout_seconds = 5
reconnect_delay_seconds = 3
# Periodic logs include cumulative expected/received/lost packets and loss rate.
stats_interval_seconds = 10
max_buffer_bytes = 65536
# Keep modem-control outputs inactive before the port opens. Any change must be
# jointly confirmed with the device team because DTR/RTS can reset hardware.
dtr = false
rts = false
# A valid stream already present, or a standalone 0x01 after the active 7-byte
# ACK, validates the device immediately. Existing streams skip ACK and E1. On
# the ACK path, algorithm initialization and write-only E1 happen only after
# validation; algorithm/E1 failure is not classified as validation_failed.

[ble]
# Ignored while data_source.type = "serial". Enable only for BLE regression.
enabled = false
# On every unconnected cycle, scan matching advertisements and connect the highest RSSI.
device_name = "Flowtime Headband"
model_nbr_uuid = "0000ff10-1212-abcd-1523-785feabcd123"
scan_timeout_seconds = 5
reconnect_delay_seconds = 3

[recording]
# Optional protected transport trace; stop retaining whole chunks at the session budget.
transport_trace_enabled = false
transport_trace_max_bytes = 1048576
directory = "/var/lib/neurobridge/recordings"
subject_id = ""
# Optional pinned recording ID for offline replay in compatible non-serial
# strategies. It must remain empty for the Kylin earphone USB serial strategy;
# serial rejects a configured replay target and never falls back to recordings.
replay_recording_id = ""
replay_speed = 1.0

[download]
# In local_browser mode this service is loopback-only. The legacy wired mode
# must use only the approved isolated private address.
enabled = true
host = "127.0.0.1"
port = 8766
path = "/downloads"

# Size archives use UTC timestamps and unique suffixes; active filename stays fixed.
[logging]
rotation_mode = "size"
max_bytes = 10485760
backup_count = 14
# Persisted operations log; external mode is reserved for managed logrotate deployments.
directory = "/var/log/neurobridge"
filename = "neurobridge.log"
level = "INFO"

[algorithm]
# The product candidate requires the locked bridge inside its bundled runtime.
enabled = true
command = ["/opt/neurobridge/runtime/bin/neurobridge_affective_bridge"]
request_timeout_ms = 2000

[storage]
warning_threshold_bytes = 5368709120
critical_threshold_bytes = 1073741824
segment_duration_seconds = 600
segment_max_bytes = 268435456
writer_queue_size = 1024
recovery_margin_bytes = 1073741824
recovery_checks = 3
fsync_interval_records = 64
session_retention_days = 30
auto_cleanup_enabled = false

# Initial bounds; tune after target-machine observation, not delivery guarantees.
[pipeline]
source_queue_size = 64
source_enqueue_timeout_ms = 50
algorithm_queue_size = 8
persistence_timeout_ms = 100
shutdown_timeout_ms = 5000
send_timeout_ms = 5000
metrics_interval_seconds = 10
