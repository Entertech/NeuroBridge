# Copy to /etc/neurobridge/gateway.toml; do not put recordings in git.
[server]
host = "127.0.0.1"
port = 8765
path = "/neurobridge/v1/ws"

[access]
# local_browser: the default single-machine strategy. The bundled browser UI,
# WebSocket service, and downloads bind only to 127.0.0.1; no B-side cable,
# static Ethernet address, or DHCP service is required.
# wired_b_side: legacy strategy for a separate B-side host on an isolated
# Ethernet link. Set server/download to the approved private address, disable
# local_ui, and configure the [network] fields documented below.
mode = "local_browser"

[local_ui]
enabled = true
host = "127.0.0.1"
port = 8080
# The deployed checkout contains the browser assets at this path. Source-tree
# runs may omit it and use the auto-detected web/b-client-test directory.
directory = "/opt/neurobridge/web/b-client-test"

[network]
# local_browser keeps this static with no interface or subnet fields; traffic
# stays on the operating-system loopback device.
mode = "static"
# Legacy wired_b_side static example:
# interface = "enp1s0"
# subnet_cidr = "192.168.88.0/24"
# Legacy wired_b_side DHCP additionally requires:
# dhcp_range_start = "192.168.88.20"
# dhcp_range_end = "192.168.88.200"
# dhcp_lease_time = "12h"

# Current Kylin deployment uses the USB-derived serial strategy. Switch to
# bluetooth only for an explicitly approved BLE regression deployment.
[data_source]
type = "serial"

[serial]
# auto probes only USB-derived ttyACM/ttyUSB candidates in stable order and
# stops immediately after the first complete fixed handshake.
device = "auto"
candidate_types = ["ttyACM", "ttyUSB"]
baud_rate = 115200
handshake_timeout_ms = 1000
# 0xE1/0xE0 succeed when any non-empty response arrives within this timeout.
command_response_timeout_ms = 1000
data_timeout_seconds = 5
reconnect_delay_seconds = 3
# Periodic logs include cumulative expected/received/lost packets and loss rate.
stats_interval_seconds = 10
max_buffer_bytes = 65536

[ble]
# Ignored while data_source.type = "serial". Enable only for BLE regression.
enabled = false
# On every unconnected cycle, scan matching advertisements and connect the highest RSSI.
device_name = "Flowtime Headband"
model_nbr_uuid = "0000ff10-1212-abcd-1523-785feabcd123"
scan_timeout_seconds = 5
reconnect_delay_seconds = 3

[recording]
directory = "/var/lib/neurobridge/recordings"
subject_id = ""
# Optional pinned recording ID for offline replay. When empty, missing, or no
# longer valid, the gateway automatically selects the newest non-empty saved
# session below recording.directory.
replay_recording_id = ""
replay_speed = 1.0

[download]
# In local_browser mode this service is loopback-only. The legacy wired mode
# must use only the approved isolated private address.
enabled = true
host = "127.0.0.1"
port = 8766
path = "/downloads"

[logging]
# Persisted operations log. Ubuntu logrotate retains 14 daily archives.
directory = "/var/log/neurobridge"
filename = "neurobridge.log"
level = "INFO"

[algorithm]
# Ubuntu installation builds the locked bridge automatically at
# /usr/local/lib/neurobridge/neurobridge_affective_bridge; no command needs to
# be entered here. The default is enabled; use false only for a deliberate
# raw-data-only POC or maintenance window.
enabled = true
