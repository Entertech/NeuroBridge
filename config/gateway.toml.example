# Copy to /etc/neurobridge/gateway.toml; do not put recordings in git.
[server]
host = "192.168.88.10" # Default gateway static IP; replace only with a deployment-approved value.
port = 8765            # To be confirmed with B-end host.
path = "/neurobridge/v1/ws"
# Per-send deadline and bounded per-subscription delivery queue. A failed or
# stalled client is closed; acquisition continues, without retransmission.
send_timeout_seconds = 5.0
delivery_queue_size = 16

[network]
# static: startup appends this dedicated address, preserving existing LAN state.
# dhcp: the gateway retains server.host as its static link address and uses the
# optional DHCP unit to assign the B-side address and advertise server.host as
# the default gateway. The B-side then connects to the configured fixed port.
mode = "static"
# `auto` is safe only when this host has one physical Ethernet NIC. With more
# than one NIC, set the dedicated B-side interface explicitly (for example,
# `enp1s0`) and rerun the installer. No new default route or DNS is configured.
interface = "auto"
subnet_cidr = "192.168.88.0/24"
# At every systemd start, append this fixed address while preserving existing
# LAN/DHCP addresses, routes and DNS. Repair an alias removed on reconnect.
ensure_static_address = true
address_check_interval_seconds = 5.0
# The following fields are required only when mode = "dhcp". DHCP requires an
# explicit interface name; it never accepts `auto`.
# dhcp_range_start = "192.168.88.20"
# dhcp_range_end = "192.168.88.200"
# dhcp_lease_time = "12h"

[ble]
# Enabled only after a real headband POC on the target Ubuntu x86_64 host.
enabled = false
# On every unconnected cycle, scan matching advertisements and connect the highest RSSI.
device_name = "Flowtime Headband"
model_nbr_uuid = "0000ff10-1212-abcd-1523-785feabcd123"
scan_timeout_seconds = 5
reconnect_delay_seconds = 3

[recording]
directory = "/var/lib/neurobridge/recordings"
subject_id = ""
# Optional pinned recording ID for offline replay. When empty, missing, or no
# longer valid, the gateway automatically selects the newest non-empty saved
# session below recording.directory.
replay_recording_id = ""
replay_speed = 1.0

[download]
# This HTTP service is only for the dedicated wired deployment network. It has
# no TLS or application authentication, so never expose it to a public or
# unmanaged LAN. Confirm this static IP and port with the receiving host.
enabled = true
host = "192.168.88.10"
port = 8766
path = "/downloads"

[logging]
# Persisted operations log. Ubuntu logrotate retains 14 daily archives.
directory = "/var/log/neurobridge"
filename = "neurobridge.log"
level = "INFO"
# Linux read-only network polling and BLE/capture summaries; 0 disables these
# periodic diagnostics. Failures and connection transitions are still logged.
diagnostics_interval_seconds = 30.0

[algorithm]
# Ubuntu installation builds the locked bridge automatically at
# /usr/local/lib/neurobridge/neurobridge_affective_bridge; no command needs to
# be entered here. The default is enabled; use false only for a deliberate
# raw-data-only POC or maintenance window.
enabled = true
